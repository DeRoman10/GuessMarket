<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" styleClass="center-panel" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ui.controllers.ChatController">

    <ListView fx:id="chatListView" styleClass="dark-list-view" VBox.vgrow="ALWAYS" />

    <HBox spacing="10.0" alignment="CENTER">
        <TextField fx:id="messageInput" promptText="Type a message..." styleClass="dark-text-field" HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" text="Send" styleClass="action-button" onAction="#handleSendMessage"/>
    </HBox>

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
</VBox>